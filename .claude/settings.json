{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git submodule status:*)",
      "Bash(git -C smartclocking status:*)",
      "Bash(git -C smartclocking diff:*)",
      "Bash(git -C smartclocking log:*)",
      "Bash(git -C smartclocking show:*)",
      "Bash(git -C smartclocking branch:*)",
      "Bash(node --test:*)",
      "Bash(node tools/check-ai-budget.mjs)",
      "Bash(npm run build:*)",
      "Bash(grep:*)",
      "Bash(ls:*)",
      "Bash(wc:*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/protected-files-guard.mjs\"" }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|Bash",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/pii-guard.mjs\"" }
        ]
      }
    ]
  }
}
